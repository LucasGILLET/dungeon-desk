# Copier en .env (non versionné). Variables lues au build par Vite.
# API Express (l'URL ne contient pas /api)
VITE_API_URL=http://localhost:3000
# Application Auth0 (Single Page Application) et API visée
VITE_AUTH0_DOMAIN=votre-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=identifiant-client-auth0
VITE_AUTH0_AUDIENCE=https://dungeon-desk-api
